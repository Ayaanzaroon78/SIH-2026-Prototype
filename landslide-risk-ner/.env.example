# =============================================================================
# Environment Variables — Landslide Risk NER Monitoring System
# =============================================================================
# Copy this file to .env for local development.
# For Vercel: add these as Environment Variables in the Vercel project dashboard
# (Settings → Environment Variables). Never commit a real .env file to git.
# =============================================================================


# --- DATABASE --------------------------------------------------------------- #

# Local development (SQLite, no setup needed):
# DATABASE_URL=sqlite:///./landslide_dev.db

# Vercel / Production (use an external database — Vercel Postgres, Supabase, etc.):
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/landslide_ner_db

# Docker Compose local overrides (used by docker-compose.yml):
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=landslide_ner_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432


# --- APPLICATION ------------------------------------------------------------ #

# Generate a strong random value for production, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=sih2026_landslide_ner_secret_key_super_secure

API_V1_STR=/api
PROJECT_NAME="SIH26001 Landslide Risk Monitoring System (NER)"


# --- RISK THRESHOLDS -------------------------------------------------------- #

RISK_THRESHOLD_MODERATE=25.0
RISK_THRESHOLD_HIGH=50.0
RISK_THRESHOLD_CRITICAL=75.0


# --- CORS (Vercel production) ------------------------------------------------ #

# Comma-separated list of allowed frontend origins.
# Set this in Vercel's Environment Variables to lock down CORS in production.
# Example: ALLOWED_ORIGINS=https://your-app.vercel.app,https://yourdomain.com
# Leave blank or unset to allow all origins (wildcard — only safe for dev/demo).
ALLOWED_ORIGINS=


# --- ALERT CHANNELS (Simulated / Stubs) ------------------------------------- #

# Replace with real credentials to enable live SMS/email alerts.
TWILIO_ACCOUNT_SID=mock_sid
TWILIO_AUTH_TOKEN=mock_token
TWILIO_FROM_PHONE=+15005550006
SENDGRID_API_KEY=mock_key
ALERT_EMAIL_FROM=alerts@ner-landslide-monitoring.gov.in


# --- VERCEL RUNTIME --------------------------------------------------------- #

# Vercel automatically sets VERCEL=1 in serverless function environments.
# The app uses this to:
#   - Switch the SQLite path to /tmp (the only writable dir in serverless)
#   - Disable the APScheduler background thread (not supported in serverless)
# DO NOT set this manually unless you are testing serverless behaviour locally.
# VERCEL=1
